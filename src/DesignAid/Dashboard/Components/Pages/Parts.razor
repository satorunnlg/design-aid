@page "/parts"
@page "/parts/{PartNumber}"
@inject DashboardService DashboardService
@inject ISnackbar Snackbar

<PageTitle>パーツ一覧 - Design Aid</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">パーツ一覧</MudText>

@* フィルター *@
<MudGrid Class="mb-4">
    <MudItem xs="12" sm="4">
        <MudTextField @bind-Value="_searchText"
                      Placeholder="型式・名称で検索..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true"
                      DebounceInterval="300"
                      OnDebounceIntervalElapsed="LoadPartsAsync" />
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudSelect T="PartType?" Value="_typeFilter" Label="種別"
                   Clearable="true" ValueChanged="OnTypeFilterChanged">
            <MudSelectItem T="PartType?" Value="@(PartType.Fabricated)">製作物</MudSelectItem>
            <MudSelectItem T="PartType?" Value="@(PartType.Purchased)">購入品</MudSelectItem>
            <MudSelectItem T="PartType?" Value="@(PartType.Standard)">規格品</MudSelectItem>
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudSelect T="HandoverStatus?" Value="_statusFilter" Label="ステータス"
                   Clearable="true" ValueChanged="OnStatusFilterChanged">
            <MudSelectItem T="HandoverStatus?" Value="@(HandoverStatus.Draft)">設計中</MudSelectItem>
            <MudSelectItem T="HandoverStatus?" Value="@(HandoverStatus.Ordered)">手配済み</MudSelectItem>
            <MudSelectItem T="HandoverStatus?" Value="@(HandoverStatus.Delivered)">納品済み</MudSelectItem>
            <MudSelectItem T="HandoverStatus?" Value="@(HandoverStatus.Canceled)">キャンセル</MudSelectItem>
        </MudSelect>
    </MudItem>
</MudGrid>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudSimpleTable Dense="true" Hover="true" Striped="true">
        <thead>
            <tr>
                <th>型式</th>
                <th>名称</th>
                <th>種別</th>
                <th>ステータス</th>
                <th>更新日時</th>
                <th style="width: 48px;"></th>
            </tr>
        </thead>
        <tbody>
            @if (_parts.Count == 0)
            {
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            該当するパーツがありません
                        </MudText>
                    </td>
                </tr>
            }
            else
            {
                @foreach (var part in _parts)
                {
                    <tr>
                        <td><MudText Typo="Typo.body2" Style="font-weight: 600;">@part.PartNumber</MudText></td>
                        <td>@part.Name</td>
                        <td>@part.Type</td>
                        <td>
                            <MudChip T="string" Size="Size.Small"
                                     Color="@GetStatusColor(part.Status)">
                                @part.Status
                            </MudChip>
                        </td>
                        <td>@part.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Size="Size.Small"
                                           Color="Color.Primary"
                                           OnClick="() => OpenEditDialog(part)"
                                           aria-label="パーツ情報を編集" />
                        </td>
                    </tr>
                }
            }
        </tbody>
    </MudSimpleTable>

    <MudText Typo="Typo.caption" Class="mt-2" Color="Color.Secondary">
        @_parts.Count 件表示
    </MudText>
}

@* パーツ編集ダイアログ *@
<MudDialog @bind-Visible="_editDialogVisible" Options="_editDialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">パーツ情報の編集</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField Value="@_editingPart?.PartNumber" Label="型式" ReadOnly="true" Class="mb-3" />
        <MudTextField @bind-Value="_editName" Label="名称" Class="mb-3" />
        <MudTextField @bind-Value="_editMemo" Label="メモ" Lines="3" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseEditDialog">キャンセル</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   OnClick="SavePartAsync" Disabled="_saving">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            保存
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public string? PartNumber { get; set; }

    private List<PartSummaryItem> _parts = [];
    private bool _loading = true;
    private string? _searchText;
    private PartType? _typeFilter;
    private HandoverStatus? _statusFilter;

    // 編集ダイアログ
    private bool _editDialogVisible;
    private PartSummaryItem? _editingPart;
    private string _editName = "";
    private string _editMemo = "";
    private bool _saving;
    private readonly DialogOptions _editDialogOptions = new()
    {
        MaxWidth = MaxWidth.Small,
        FullWidth = true
    };

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(PartNumber))
            _searchText = PartNumber;

        await LoadPartsAsync();
    }

    private async Task LoadPartsAsync()
    {
        _loading = true;
        try
        {
            _parts = await DashboardService.GetPartsAsync(_typeFilter, _statusFilter, _searchText);
        }
        catch
        {
            _parts = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnTypeFilterChanged(PartType? value)
    {
        _typeFilter = value;
        await LoadPartsAsync();
    }

    private async Task OnStatusFilterChanged(HandoverStatus? value)
    {
        _statusFilter = value;
        await LoadPartsAsync();
    }

    private void OpenEditDialog(PartSummaryItem part)
    {
        _editingPart = part;
        _editName = part.Name;
        _editMemo = part.Memo ?? "";
        _editDialogVisible = true;
    }

    private void CloseEditDialog()
    {
        _editDialogVisible = false;
        _editingPart = null;
    }

    private async Task SavePartAsync()
    {
        if (_editingPart is null) return;

        _saving = true;
        try
        {
            var success = await DashboardService.UpdatePartAsync(
                _editingPart.Id,
                _editName,
                _editMemo);

            if (success)
            {
                Snackbar.Add("パーツ情報を更新しました", Severity.Success);
                _editDialogVisible = false;
                _editingPart = null;
                await LoadPartsAsync();
            }
            else
            {
                Snackbar.Add("パーツが見つかりません", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"更新に失敗しました: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private static Color GetStatusColor(string status) => status switch
    {
        "設計中" => Color.Default,
        "手配済み" => Color.Warning,
        "納品済み" => Color.Success,
        "キャンセル" => Color.Error,
        _ => Color.Default
    };
}
